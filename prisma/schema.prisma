generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OFFICER
  CONTRACTOR
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum Department {
  DISTRICT_ADMINISTRATION
  AGRICULTURE
  SOCIAL_WELFARE
  WORKS_CONSTRUCTION
  SOIL_WATER_CONSERVATION
  RURAL_WATER_SUPPLY
  HEALTH
  EDUCATION_PRIMARY
  EDUCATION_SECONDARY
  ACCOUNTS_FINANCE
  WATER_SUPPLY_SANITATION
  GRAM_PANCHAYAT
  WOMEN_CHILD_DEVELOPMENT
  GENERAL_ADMINISTRATION
  NREGA
  NONE
}

enum LoginRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// NextAuth Required Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  role          Role        @default(OFFICER)
  profileImage  String?
  password      String?
  phone         String?

  // New hierarchy / approval fields
  status        UserStatus  @default(PENDING_APPROVAL)
  designation   String?
  department    Department  @default(NONE)
  hierarchyLevel Int        @default(99)
  isSuperAdmin  Boolean     @default(false)
  isDeptAdmin   Boolean     @default(false)

  accounts      Account[]
  sessions      Session[]

  // Custom relations
  managedProjects         Project[]        @relation("OfficerProjects")
  contractedProjects      Project[]        @relation("ContractorProjects")
  notifications           Notification[]
  contractorPaymentReqs   PaymentRequest[] @relation("ContractorPaymentRequests")
  officerPaymentReqs      PaymentRequest[] @relation("OfficerPaymentRequests")
}

model LoginRequest {
  id            String             @id @default(cuid())
  name          String
  email         String?
  phone         String?
  password      String
  requestedRole Role
  status        LoginRequestStatus @default(PENDING)
  adminNote     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// GPOMS Custom Models
enum ProjectStatus {
  ONGOING
  DELAYED
  COMPLETED
}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  status        ProjectStatus @default(ONGOING)
  budgetPlanned Float
  budgetActual  Float         @default(0)
  tenderAmount  Float

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  officerId     String?
  officer       User?         @relation("OfficerProjects", fields: [officerId], references: [id])

  contractorId  String?
  contractor    User?         @relation("ContractorProjects", fields: [contractorId], references: [id])

  tasks           Task[]
  installments    Installment[]
  paymentRequests PaymentRequest[]
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      TaskStatus  @default(PENDING)
  dueDate     DateTime?

  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  paymentRequests PaymentRequest[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Installment {
  id          String   @id @default(cuid())
  amount      Float
  datePaid    DateTime @default(now())
  description String?

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PaymentRequest {
  id           String               @id @default(cuid())
  amount       Float
  description  String
  proofImages  String[]
  status       PaymentRequestStatus @default(PENDING)
  officerNote  String?

  taskId       String?
  task         Task?                @relation(fields: [taskId], references: [id])

  projectId    String
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  contractorId String
  contractor   User                 @relation("ContractorPaymentRequests", fields: [contractorId], references: [id])

  officerId    String?
  officer      User?                @relation("OfficerPaymentRequests", fields: [officerId], references: [id])

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}
